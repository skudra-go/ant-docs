{
  "name": "ant-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for the ant ORM",
  "scripts": {
    "start": "docusaurus start",
    "build": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-build docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear && rm -rf .docusaurus-build",
    "check:samples": "cd tools/doccheck && go run ./cmd/doccheck ../../docs && go run ./cmd/doccheck ../../blog",
    "fix:samples": "cd tools/doccheck && go run ./cmd/doccheck -fix ../../docs && go run ./cmd/doccheck -fix ../../blog",
    "api": "cd tools/doccheck && go run ./cmd/apiindex ../../src/remark/api.json",
    "check": "npm run check:samples && npm test && npm run build",
    "test": "node --test src/plugins/",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "wrangler": "4.151.1"
  }
}
